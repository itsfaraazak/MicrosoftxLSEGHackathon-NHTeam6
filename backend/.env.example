# Copy to .env (gitignored). Placeholders only; never commit real values.
USE_MOCKS=1
FLASK_PORT=5000

# LLM (any OpenAI-compatible endpoint). Generic names win; Azure names are the fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: header name carrying the key, e.g. api-key or Authorization (default: Bearer via the client)
LLM_AUTH_HEADER=
# Seconds: per model call, and total budget per request across retries
LLM_TIMEOUT_S=12
LLM_DEADLINE_S=18

# Azure OpenAI / AI Foundry fallback (base URL becomes <endpoint>/openai/v1/)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Cosmos DB (optional; local JSONL fallback if unset)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=dontdoubledown

# Hackathon portal (Azure-style route). Get key from the portal: Account > API Details. Models: gpt-6.1-sol, gpt-6-luna, gpt-6-astra, gpt-5.6-terra, MAI-Thinking-1
# LLM_BASE_URL=https://app-uoaihack2ix6ak.azurewebsites.net
# LLM_API_VERSION=2024-10-21
# LLM_MODEL=gpt-6-luna
# LLM_MAX_TOKENS=2000
# Fast model for structured extraction (parse profile / exposure). Main model answers questions.
# LLM_FAST_MODEL=gpt-5.6-terra
