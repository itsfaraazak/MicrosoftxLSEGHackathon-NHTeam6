# Copy to .env (gitignored). Get values from the team-06 credential sheet / Azure portal. NEVER commit .env.
FLASK_PORT=5000
USE_MOCKS=1

# LLM: Azure AI Foundry / Azure OpenAI (v1 endpoint)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# DB: Azure Cosmos DB for NoSQL (leave blank to fall back to local data/local_store.jsonl)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=dontdoubledown

# Data
FRED_API_KEY=

# Optional: Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=
